          "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "// Save JWT token to collection variable 'jwt_token' when sign-in succeeds",
                    "if (pm.response.code === 200) {",
                    "  try {",
                    "    var jsonData = pm.response.json();",
                    "    var token = jsonData.accessToken || jsonData.token || (jsonData.data && (jsonData.data.accessToken || jsonData.data.token));",
                    "    if (token) {",
                    "      pm.collectionVariables.set('jwt_token', token);",
                    "      console.log('Saved jwt_token to collection variables');",
                    "      pm.test('jwt_token saved', function () { pm.expect(token).to.exist; });",
                    "    } else {",
                    "      console.log('Sign-in response did not contain an access token');",
                    "    }",
                    "  } catch (e) {",
                    "    console.log('Sign-in response not valid JSON or missing token:', e);",
                    "  }",
                    "} else {",
                    "  console.log('Sign-in returned', pm.response.code, '- no token saved');",
                    "}"
                  ]
                }
              }
            ]
          },
